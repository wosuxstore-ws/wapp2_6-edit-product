<?xml version="1.0" encoding="utf-8"?>
<!-- Add Account: account name, bank / wallet (opens a list from wallets_and_banks), amount. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_bg">

    <!-- ============ Header: back / title ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/backButton"
            style="@style/HeaderCircleButton"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="@color/home_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Add Account"
            android:textColor="@color/home_title"
            android:textSize="17sp"
            android:fontFamily="@font/poppins_medium" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- ===== Account name ===== -->
            <TextView
                style="@style/PersonFormLabel"
                android:layout_marginTop="6dp"
                android:text="Account name" />

            <EditText
                android:id="@+id/accountNameInput"
                style="@style/PersonFormInput"
                android:hint="e.g. Shop account"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLength="150" />

            <!-- ===== Bank / wallet (opens a list from the wallets_and_banks table) ===== -->
            <TextView
                style="@style/PersonFormLabel"
                android:text="Bank or wallet" />

            <LinearLayout
                android:id="@+id/bankField"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:id="@+id/selectedBankLogo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/selectedBankName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:hint="Select bank or wallet"
                    android:maxLines="1"
                    android:textColor="@color/home_title"
                    android:textColorHint="@color/home_nav_inactive"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/home_nav_inactive" />
            </LinearLayout>

            <!-- ===== Amount ===== -->
            <TextView
                style="@style/PersonFormLabel"
                android:text="Amount" />

            <EditText
                android:id="@+id/accountAmountInput"
                style="@style/PersonFormInput"
                android:hint="0.00"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLength="16" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null"
                android:text="Save account"
                android:textAllCaps="false"
                android:textColor="#14183C"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_medium" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
