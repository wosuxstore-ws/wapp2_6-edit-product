<?xml version="1.0" encoding="utf-8"?>
<!-- Add Bill: bill photo (take a picture or pick one), person (role_id = 4, searchable list),
     amount, paid, payment method, status and date. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_bg">

    <!-- ============ Header: back / title ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/backButton"
            style="@style/HeaderCircleButton"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="@color/home_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Add Bill"
            android:textColor="@color/home_title"
            android:textSize="17sp"
            android:fontFamily="@font/poppins_medium" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- ===== Bill photo ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/bg_search"
                android:clipToOutline="true">

                <LinearLayout
                    android:id="@+id/billPlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_receipt"
                        app:tint="@color/home_nav_inactive" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No bill photo yet"
                        android:textColor="@color/home_nav_inactive"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/billPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Selected bill photo"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnCamera"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_button_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/home_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Take photo"
                        android:textColor="@color/home_title"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnGallery"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_gallery"
                        app:tint="@color/home_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Upload photo"
                        android:textColor="@color/home_title"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_medium" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/removePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp"
                android:text="Remove photo"
                android:textColor="@color/notif_dot"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                android:visibility="gone" />

            <!-- ===== Person (opens a searchable list: wpeople where role_id = 4) ===== -->
            <TextView
                style="@style/PersonFormLabel"
                android:text="Person" />

            <LinearLayout
                android:id="@+id/personField"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/billPersonName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:hint="Select person"
                    android:maxLines="1"
                    android:textColor="@color/home_title"
                    android:textColorHint="@color/home_nav_inactive"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/home_nav_inactive" />
            </LinearLayout>

            <!-- ===== Amount ===== -->
            <TextView
                style="@style/PersonFormLabel"
                android:text="Amount" />

            <EditText
                android:id="@+id/billAmount"
                style="@style/PersonFormInput"
                android:digits="0123456789."
                android:hint="0.00"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLength="16" />

            <!-- ===== Paid ===== -->
            <TextView
                style="@style/PersonFormLabel"
                android:text="Paid" />

            <EditText
                android:id="@+id/billPaid"
                style="@style/PersonFormInput"
                android:digits="0123456789."
                android:hint="0.00"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLength="16" />

            <!-- ===== Payment method (Cash + the banks / wallets from wallets_and_banks) ===== -->
            <TextView
                style="@style/PersonFormLabel"
                android:text="Payment method" />

            <LinearLayout
                android:id="@+id/methodField"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:id="@+id/methodLogo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/methodName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:hint="Select payment method"
                    android:maxLines="1"
                    android:textColor="@color/home_title"
                    android:textColorHint="@color/home_nav_inactive"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/home_nav_inactive" />
            </LinearLayout>

            <!-- ===== Status ===== -->
            <TextView
                style="@style/PersonFormLabel"
                android:text="Status" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusUnpaid"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Unpaid"
                    android:textColor="@color/home_blue"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_medium" />

                <TextView
                    android:id="@+id/statusPartial"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Partial"
                    android:textColor="@color/home_chip_text"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_medium" />

                <TextView
                    android:id="@+id/statusPaid"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Paid"
                    android:textColor="@color/home_chip_text"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>

            <!-- ===== Date (opens a calendar; starts as today) ===== -->
            <TextView
                style="@style/PersonFormLabel"
                android:text="Date" />

            <LinearLayout
                android:id="@+id/dateField"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/dateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:textColor="@color/home_title"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/home_nav_inactive" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null"
                android:text="Save bill"
                android:textAllCaps="false"
                android:textColor="#14183C"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_medium" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
