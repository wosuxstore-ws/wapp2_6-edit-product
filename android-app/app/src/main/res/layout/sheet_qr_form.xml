<?xml version="1.0" encoding="utf-8"?>
<!-- Popup (BottomSheetDialog) that opens after a QR is scanned, already filled in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/qr_form_title"
            android:textColor="@color/home_title"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/qrClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_soft"
            android:contentDescription="@string/qr_cd_close"
            android:padding="14dp"
            android:src="@drawable/ic_close"
            app:tint="@color/home_title" />
    </LinearLayout>

    <TextView
        android:id="@+id/qrSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/home_nav_inactive"
        android:textSize="13sp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView style="@style/QrFieldLabel" android:text="@string/qr_f_name" />
            <EditText
                android:id="@+id/qrName"
                style="@style/QrFieldInput"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:maxLength="150" />

            <TextView style="@style/QrFieldLabel" android:text="@string/qr_f_sku" />
            <EditText
                android:id="@+id/qrSku"
                style="@style/QrFieldInput.ReadOnly" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/QrFieldLabel" android:text="@string/qr_f_number" />
                    <EditText
                        android:id="@+id/qrNumber"
                        style="@style/QrFieldInput.ReadOnly" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/QrFieldLabel" android:text="@string/qr_f_bill" />
                    <EditText
                        android:id="@+id/qrBill"
                        style="@style/QrFieldInput.ReadOnly" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/QrFieldLabel" android:text="@string/qr_f_buy" />
            <EditText
                android:id="@+id/qrBuy"
                style="@style/QrFieldInput"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/QrFieldLabel" android:text="@string/qr_f_min" />
                    <EditText
                        android:id="@+id/qrMin"
                        style="@style/QrFieldInput"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/QrFieldLabel" android:text="@string/qr_f_max" />
                    <EditText
                        android:id="@+id/qrMax"
                        style="@style/QrFieldInput"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <!-- date: tap to change -->
            <TextView style="@style/QrFieldLabel" android:text="@string/qr_f_date" />
            <EditText
                android:id="@+id/qrDate"
                style="@style/QrFieldInput"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/QrFieldLabel" android:text="@string/qr_f_category" />
                    <EditText
                        android:id="@+id/qrCategory"
                        style="@style/QrFieldInput"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="10" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/QrFieldLabel" android:text="@string/qr_f_store" />
                    <EditText
                        android:id="@+id/qrStore"
                        style="@style/QrFieldInput"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLength="10" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/qrError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="4dp"
                android:text="@string/qr_err_fields"
                android:textColor="@color/notif_dot"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/qrCancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:fontFamily="@font/poppins_medium"
            android:stateListAnimator="@null"
            android:text="@string/qr_btn_cancel"
            android:textAllCaps="false"
            android:textColor="@color/home_title"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/qrSave"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="@font/poppins_medium"
            android:stateListAnimator="@null"
            android:text="@string/qr_btn_save"
            android:textAllCaps="false"
            android:textColor="#14183C"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
